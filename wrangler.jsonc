{
  "name": "cizzuk",
  "compatibility_date": "2026-06-30",
  "workers_dev": false,
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "npm run build",
    "watch_dir": ["src", "public"]
  },
  "routes": [
    {
      "pattern": "cizzuk.net",
      "custom_domain": true
    }
  ]
}