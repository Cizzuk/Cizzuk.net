{% set lang = lang | default(site.lang) %}
<!doctype html>
<html{% if lang %} lang="{{ lang }}"{% endif %}>
  <head>
    {% include "head.njk" %}
  </head>
  
  <body>
    {% if type != "home" %}
    <header>
      <a href="/">
        <img class="drpct" src="{{ site.icons.proficon }}" alt aria-hidden>
        <span>{{ site.title }}</span>
      </a>
      {% if alternate_langs %}
      <ul>
        {% for alternate_lang in alternate_langs %}
        {% if alternate_lang.lang != lang %}
        <li>
          <a href="{{ alternate_lang.url }}"
             lang="{{ alternate_lang.lang }}"
             hreflang="{{ alternate_lang.lang }}"
             data-alternate-lang="{{ alternate_lang.lang }}">
            {{ alternate_lang.name }}
          </a>
        </li>
        {% endif %}
        {% endfor %}
      </ul>
      {% endif %}
    </header>
    {% endif %}

    {% block content %}{% endblock %}

    <footer>
      <p class="copy">© {% currentYear %} Cizzuk</p>
      <ul>
        <li><a href="/projects/">Projects</a></li>
        <li><a href="/posts/">Posts</a></li>
        <li><a href="/notes/">Notes</a></li>
      </ul>
    </footer>
  </body>
</html>
