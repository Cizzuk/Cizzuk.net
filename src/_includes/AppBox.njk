{%- macro AppBox(item, heading="b") -%}
  {%- set data = item.data if item.data else item -%}
  {%- set content -%}
    {%- if data.icon -%}
    <img src="{{ data.icon }}" class="appbox-icon" alt aria-hidden>
    {%- endif -%}
    <div class="appbox-info">
      <{{ heading }} class="appbox-title">{{ data.title }}</{{ heading }}>
      {%- if data.description -%}
      <p>{{ data.description }}</p>
      {%- endif -%}
    </div>
  {%- endset -%}

  {%- if item.url -%}
  <a href="{{ item.url }}" class="appbox">
    {{ content | safe }}
  </a>
  {%- else -%}
  <div class="appbox">
    {{ content | safe }}
  </div>
  {%- endif -%}
{%- endmacro -%}